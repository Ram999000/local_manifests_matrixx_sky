           name="Ram999000/device_xiaomi_sky"
           remote="sky-remote"
           revision="16" />

  <!-- Vendor Blobs (Android 16) -->
  <project path="vendor/xiaomi/sky"
           name="Ram999000/vendor_xiaomi_sky"
           remote="sky-remote"
           revision="16" />

  <!-- Kernel Tree (Android 16) -->
