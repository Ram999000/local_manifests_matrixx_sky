<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Unique Remote to avoid conflict -->
  <remote name="sky-remote"
          fetch="https://github.com" />

  <!-- Fix for Matrixx frameworks/base naming bug -->
  <remove-project name="android_frameworks_base" />
  <project path="frameworks/base"
           name="ProjectMatrixx/frameworks_base"
           remote="sky-remote"
           revision="15.0" />

  <!-- Device Tree -->
  <project path="device/xiaomi/sky"
           name="Ram999000/android_device_xiaomi_sky"
           remote="sky-remote"
           revision="15.0" />

  <!-- Vendor Blobs -->
  <project path="vendor/xiaomi/sky"
           name="Ram999000/android_vendor_xiaomi_sky"
           remote="sky-remote"
           revision="15.0" />

  <!-- Kernel Tree (Prebuilt kernel matched with BoardConfig.mk) -->
  <project path="device/xiaomi/sky-kernel"
           name="Ram999000/android_xiaomi_sky_kernel"
           remote="sky-remote"
           revision="15.0" />

  <!-- Dolby Hardware Dependency (Android 15) -->
  <project path="hardware/dolby"
           name="crdroidandroid/android_hardware_dolby"
           remote="sky-remote"
           revision="15.0" />

  <!-- Xiaomi Hardware Dependency (Lineage 22.2 Base) -->
  <project path="hardware/xiaomi"
           name="LineageOS/android_hardware_xiaomi"
           remote="sky-remote"
           revision="lineage-22.2" />

</manifest>
