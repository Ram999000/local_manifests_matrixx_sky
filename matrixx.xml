           name="Ram999000/device_xiaomi_sky-kernel"
           remote="sky-remote"
           revision="16" />

  <!-- Dolby Hardware Dependency -->
  <project path="hardware/dolby"
           name="Ram999000/hardware_dolby"
           remote="sky-remote"
           revision="a" />

  <!-- Xiaomi Hardware Dependency -->
