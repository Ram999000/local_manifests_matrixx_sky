           name="Ram999000/android_hardware_xiaomi"
           remote="sky-remote"
           revision="lineage-23.2" />

  <!-- Fixed Hardware Compat (No Duplicate Protobuf) -->
  <remove-project name="LineageOS/android_hardware_lineage_compat" />
  <project path="hardware/lineage/compat"
           name="Ram999000/android_hardware_lineage_compat"
           remote="sky-remote"
           revision="lineage-23.2" />
